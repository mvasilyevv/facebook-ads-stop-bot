{
  "name": "fb-stop-bot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../packages/shared/scripts/check-frontend-budget.mjs --dist ./dist --feature OperatorDashboard.tsx --js-budget 250000 --js-headroom 20000 --font-budget 100000",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"stories/**/*.{ts,tsx}\"",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "vite build && playwright test",
    "test:visual:linux": "VISUAL_BASELINE_PLATFORM=linux playwright test --grep @visual --project=1280px",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fb/features": "workspace:*",
    "@fb/operator-api": "workspace:*",
    "@fb/operator-ui": "workspace:*",
    "@fb/shared": "workspace:*",
    "@fontsource-variable/commissioner": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.95.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.95.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^0.11.2",
    "globals": "^15.14.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
