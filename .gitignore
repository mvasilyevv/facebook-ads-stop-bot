# Временные файлы Python
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/
.pytest_cache/

# Виртуальное окружение и конфигурация
.venv/
.env
.env.local
**/.env.local

# Системные файлы и кэш редакторов
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Вспомогательные папки ИИ и агентов.
# .claude/agents/ (определения субагентов), .claude/skills/ (симлинки на
# .agents/skills/) и .claude/commands/ (slash-команды) ВЕРСИОНИРУЕМ — это
# проектные инструкции. Локальное (settings.local.json, plans/, worktrees/)
# остаётся в игноре.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/
.claude-flow/
.omc/
.mcp.json
.playwright-mcp/
.superpowers/
scratch/

# Временные папки, логи и результаты тестов
.tmp
.tmp/
.logs/
logs/
recordings/
supervisord.pid
supervisord.log
playwright-report/
test-results/
npm-debug.log*

# Зависимости и сборка фронтенда
frontend/dist/
frontend/node_modules/
frontend-mini/dist/
frontend-mini/node_modules/
services/browser-agent/node_modules/

# Локальные базы данных
*.db
*.sqlite
*.sqlite3

# Секреты и конфиденциальные данные
helm/fb-stop-bot/secrets.yaml
data/secrets_backup_*.json

# Локальные данные (медиа Ad Library, бэкапы)
data/ad_library_media/
data/cleanup_audit/


# Куки/сессия разведочного браузера (расходный FB-аккаунт) — не коммитить
data/recon_profile/
data/recon_adlib_profile/
data/recon_out/

# Медиа конкурентов из Ad Library (референсы, не в репо)
data/competitor_refs/
.am_capture/

# Скриншоты-черновики сессий (syntx/recon/veo) — только корень репо
/*.png
/*.jpg
/*.jpeg

# Локальные MCP-конфиги браузера (recon/syntx tooling)
data/*mcp*.json
