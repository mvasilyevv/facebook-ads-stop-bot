# ============================================================================
# ЛОКАЛЬНЫЙ DEV-ПРОФИЛЬ — изолирован от боевого сервера.
# Скопируй в .env и заполни. Запуск: scripts/run-local.sh
#
# Гарантии изоляции от прода (money-safety):
#   - ОТДЕЛЬНЫЙ тестовый Telegram-бот (НЕ боевой токен!) → нет доступа к prod updates/outbox.
#   - Сканирование выключено (is_scanning_enabled=false по умолчанию в БД).
#   - Vision/browser-agent НЕ запускаются → авто-стоп/включение физически невозможны.
#   - observer/meta_api/cabinet_scheduler отсутствуют в корневом Compose.
#   - Свой ENCRYPTION_KEY (НЕ боевой) → локальная БД не расшифрует боевые секреты.
# ============================================================================

# Маркер dev-профиля — scripts/run-local.sh откажется стартовать без него
# (защита от случайного запуска локального облегчённого стека на боевом .env).
FB_AGENT_PROFILE=local

# === База/Redis (docker compose переопределяет хосты на service-имена) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fb_stop_bot_dev
POSTGRES_USER=fb_stop_bot
POSTGRES_PASSWORD=fb_stop_bot_local
REDIS_URL=redis://localhost:6380/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# === Шифрование (ЛОКАЛЬНАЯ пара, НЕ боевая!) ===
# Generate ENCRYPTION_KEY and ENCRYPTION_KEY_VERIFY together; see .env.example.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERIFY=

# === Telegram: ТЕСТОВЫЙ бот (отдельный токен от @BotFather, НЕ боевой!) ===
# Токен боевого бота сюда НЕЛЬЗЯ: local webhook/delivery должны работать только
# с отдельным тестовым bot identity. Это одноразовый input locked migrator;
# runtime после миграции читает только telegram_config.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://app.adpulse.su/auth/telegram/callback

# === API ===
API_HOST=0.0.0.0
API_PORT=8100
API_KEY=local_dev_key
REQUIRE_API_KEY=true
APP_TIMEZONE=Europe/Kaliningrad
FRONTEND_ORIGIN=http://localhost:5173

# === Vision transport: credentials are configured in Settings → Vision ===
# Без строки vision_config авто-стоп/сканирование fail closed — это и нужно для dev.
VISION_API_URL=http://127.0.0.1:3030
VISION_FOLDER_ID=

# === Dev Tools: локально включены (уникализация креативов, открытие папок) ===
DEV_TOOLS_ENABLED=true

# === Логи ===
LOG_FORMAT=text

# === Прочее (AI/AdSet.pro/syntx опционально — пусто для базового dev) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Одноразовые input-значения для locked migrator; runtime читает только БД.
ADSETPRO_MCP_KEY=
ADSETPRO_POSTBACK_SECRET=
