# ============================================================================
# FB Agent — шаблон окружения. Скопируйте в .env и заполните плейсхолдеры.
# Полный список настроек — Settings в core/config.py + переменные os.environ.get
# в apps/*. БЕЗ реальных секретов в этом файле.
#
# Локальный запуск выполняется только через scripts/run-local.sh; хосты БД/Redis
# публикуются на 127.0.0.1:5433 / :6380. Внутри Compose используются service-имена.
# ============================================================================

# === База данных (docker-compose, bind 127.0.0.1:5433) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fb_stop_bot
POSTGRES_USER=fb_stop_bot
# В проде задайте уникальный пароль — совпадение с POSTGRES_DB пишет warning.
POSTGRES_PASSWORD=fb_stop_bot

# === Redis (docker-compose, bind 127.0.0.1:6380) ===
REDIS_URL=redis://localhost:6380/0
# observer_worker pubsub читает REDIS_HOST/REDIS_PORT отдельно от REDIS_URL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# === Шифрование секретов в БД ===
# Fernet key and its verification token are one inseparable secret pair.
# Generate both once in a trusted shell and store them in the secret manager:
#   python -c "from cryptography.fernet import Fernet; k=Fernet.generate_key(); print('ENCRYPTION_KEY='+k.decode()); print('ENCRYPTION_KEY_VERIFY='+Fernet(k).encrypt(b'encryption_key_verify_v1').decode())"
# Both values must remain unchanged between deploys.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERIFY=

# === Telegram (runtime читает только singleton telegram_config) ===
# Токен от @BotFather — одноразовый input для locked migrator на чистой БД.
# После импорта env не является fallback; отсутствие/tombstone в БД fail closed.
# Вся доставка идёт через webhook + durable delivery worker.
TELEGRAM_BOT_TOKEN=
# Independent random secret accepted only in Telegram's webhook header.
TELEGRAM_WEBHOOK_SECRET=

# Same random value must be provisioned as the off-host Alertmanager
# credentials file; it is not the panel API key or Telegram bot token.
ALERTMANAGER_WEBHOOK_SECRET=

# Owner-only web panel login (register exact origin/callback in BotFather first)
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://app.adpulse.su/auth/telegram/callback
PANEL_AUTH_STATE_TTL_SECONDS=600
PANEL_AUTH_TICKET_TTL_SECONDS=60
PANEL_AUTH_SESSION_TTL_SECONDS=43200

# === Protected Vision desktop ===
DESKTOP_PUBLIC_ORIGIN=https://desktop.adpulse.su
DESKTOP_ACCESS_TICKET_TTL_SECONDS=300
DESKTOP_ACCESS_SESSION_TTL_SECONDS=43200
DESKTOP_OWNER_TELEGRAM_USER_ID=
# Custom webtop image must be published under an immutable registry digest.
DESKTOP_WEBTOP_IMAGE=
# Нативный канал RustDesk: пароль генерируется fbctl при publish,
# адрес и ключ брокера имеют дефолты (Tailscale-адрес хоста и ключ из
# shared/rustdesk-server); переопределяются здесь при необходимости.
DESKTOP_RUSTDESK_SERVER=
DESKTOP_RUSTDESK_BIND=
DESKTOP_RUSTDESK_KEY=

# === API ===
API_HOST=0.0.0.0
API_PORT=8100
# Пустой → write-эндпоинты вернут 503 (REQUIRE_API_KEY=true). Задайте стабильный ключ.
API_KEY=
# Enforce X-API-Key на write-эндпоинтах (POST/PUT/PATCH/DELETE). Secure-by-default.
# false — только если API закрыт в доверенной сети/localhost. Публичные пути исключены.
REQUIRE_API_KEY=true
APP_TIMEZONE=Europe/Kaliningrad
# CORS-origin фронта. Wildcard (*) запрещён — сервер упадёт при старте (CSRF-защита).
# local-dev: http://localhost:5173 ; prod — публичный URL фронта.
FRONTEND_ORIGIN=http://localhost:5173
# Доверять X-Forwarded-For для client IP (rate-limit). ВКЛЮЧАТЬ только за доверенным
# reverse-proxy (k8s-ingress/nginx). По умолчанию false (XFF подделывается).
TRUST_PROXY_HEADERS=false

# === Frontend (Vite dev-server, только вне Docker) ===
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
MINI_PORT=5174

# === Browser Agent (Node.js gRPC) ===
# Порт, на котором слушает browser-agent (services/browser-agent, env GRPC_PORT).
GRPC_PORT=50051
# Адрес browser-agent для Python-воркеров/API. Вне Docker — localhost.
# В Docker compose переопределяет на host.docker.internal (Vision/agent на хосте).
BROWSER_AGENT_HOST=localhost
BROWSER_AGENT_GRPC_HOST=localhost
BROWSER_AGENT_GRPC_PORT=50051

# === Vision Anti-detect браузер (внешний сервис на хосте) ===
# Credentials are configured through Settings → Vision and stored encrypted
# in PostgreSQL vision_config. Environment variables configure transport only.
VISION_API_URL=http://127.0.0.1:3030
VISION_FOLDER_ID=

# === Observer ===
# Интервал между scan-циклами (также настраивается через UI).
DEFAULT_OBSERVER_INTERVAL_SECONDS=90
# Owner-scoping: CSV тегов (напр. MV или MV,ABC). Кампании без любого из тегов
# игнорируются (защита от чужих кампаний в общем кабинете). Пусто → фильтр выключен.
OWNER_CAMPAIGN_TAG=
# Тюнинг observer-рантайма (опционально, дефолты в коде).
# OBSERVER_RUNTIME_TTL_SEC=60
# OBSERVER_DEGRADED_ALERT_THRESHOLD=3
# OBSERVER_DEGRADED_ALERT_TTL_SEC=3600

# === Логирование ===
# json (дефолт) | text. Воркеры читают LOG_FORMAT.
LOG_FORMAT=json
DEPLOYMENT_ENVIRONMENT=production

# === Worker metrics ===
# В поддерживаемом Compose runtime каждый worker находится в отдельном network
# namespace и слушает :9464. Карта targets: docs/worker_metrics.md.
WORKER_METRICS_ENABLED=1

# === Telegram Mini App ===
TMA_SESSION_TTL_SECONDS=3600
# Секрет для подписи TMA-токенов (itsdangerous). Пусто → фолбэк на ENCRYPTION_KEY.
# Должен быть стабильным между рестартами, иначе TMA-сессии протухают.
TMA_SESSION_SECRET=
# Одноразовый bootstrap-input: migrator импортирует HTTPS URL в system_config,
# после чего runtime читает только БД. Менять URL далее через settings API.
WEB_APP_URL=

# === Daily TG Digest ===
DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_TIMEZONE=Europe/Moscow
# Тюнинг планировщика дайджеста (опционально).
# DIGEST_HOUR_UTC=9
# DIGEST_MIN_UTC=0
# DIGEST_CHECK_INTERVAL_SEC=60
# DIGEST_SENT_TTL_SEC=93600

# === AdSet.pro (внешний MCP-сервер post-click статистики, Этап 6) ===
# Одноразовые bootstrap-inputs: migrator шифрует и импортирует их в БД.
# Runtime env fallback отсутствует; существующий DB singleton всегда авторитетен.
# AdSet.pro — MCP-сервер platform-stats-mcp на https://adset.pro/mcp (JSON-RPC + Bearer).
ADSETPRO_MCP_KEY=
ADSETPRO_BASE_URL=https://adset.pro
ADSETPRO_TIMEOUT_SECONDS=15.0
# Секрет входящего GET postback: query `token`. Минимум 32 случайных символа;
# postback-only конфигурация допустима; оба пусты → endpoint 503.
ADSETPRO_POSTBACK_SECRET=

# === Tracker event processor ===
# Интервал durable-сверки локального postback inbox с AdSet.pro API.
TRACKER_RECONCILIATION_INTERVAL_SECONDS=300

# === Health Watchdog ===
HEALTH_WATCHDOG_INTERVAL_SEC=60
HEALTH_WATCHDOG_ALERT_TTL_SEC=3600
HEALTH_WATCHDOG_OBSERVER_STALE_SEC=300
HEALTH_WATCHDOG_STARTUP_GRACE_SEC=90
# Cheap local v5/profile scheduling evidence; no Graph request and no token decrypt.
HEALTH_WATCHDOG_BROWSER_READINESS_SEC=2
HEALTH_WATCHDOG_BROWSER_READINESS_TTL_SEC=6
# Сетевой probe канала Marketing API (реальный GET /me через browser-agent). Money-критично.
HEALTH_WATCHDOG_META_PROBE_SEC=300
# HEALTH_WATCHDOG_AUTOSTOP_STUCK_MIN=15
# HEALTH_WATCHDOG_AUTOSTOP_DESYNC_MIN=15

# === Интервалы воркеров (опционально, дефолты в коде) ===
# RECONCILER_INTERVAL_SEC=30
# RECONCILER_STUCK_TIMEOUT_MIN=30
# RECONCILER_DRAFT_TIMEOUT_HOURS=24
# CLEANUP_WORKER_RUN_HOUR_UTC=4
# CLEANUP_RUN_ON_START=false
# ENABLE_RECO_INTERVAL_SEC=300
# ENABLE_RECO_COOLDOWN_SEC=3600
# ENABLE_RECO_DEDUP_TTL_SEC=21600
# CABINET_CHECK_INTERVAL_SEC=60

# === AI Assistant (опционально; пустые ключи → no-op, не падает) ===
AI_DIAGNOSTICS_ENABLED=true
AI_CHAT_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.claudehub.fun/v1
ANTHROPIC_MODEL=claude-sonnet-4.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gateway.nekocode.app/andromeda/v1
OPENAI_MODEL=gpt-5.6-luna
AI_DIAGNOSTICS_COOLDOWN_SECONDS=1800
AI_TIMEOUT_SECONDS=20
AI_MAX_LOG_LINES=200
AI_MAX_TOOL_ITERATIONS=5
AI_RATE_LIMIT_PER_HOUR=30
# === syntx.ai (прямой API генерации креативов, опционально) ===
# JWT из localStorage.auth_token залогиненного syntx (recon_profile), живёт 30 дней.
SYNTX_AUTH_TOKEN=
SYNTX_BASE_URL=https://api.syntx.ai
# SYNTX_TIMEOUT_SECONDS=60.0
# SYNTX_POLL_INTERVAL_SECONDS=3.0
# SYNTX_POLL_TIMEOUT_SECONDS=300.0

# === Dev Tools ===
# Разрешает /tools/* endpoints (уникализация креативов, открытие папок, скан ФС).
# В проде оставлять false — операции с локальной ФС на сервере бессмысленны и опасны.
DEV_TOOLS_ENABLED=false
