# === База данных (docker-compose, bind 127.0.0.1:5433) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fb_stop_bot_v2
POSTGRES_USER=fb_stop_bot_v2
# В проде задайте уникальный пароль — совпадение с POSTGRES_DB пишет warning.
POSTGRES_PASSWORD=fb_stop_bot_v2

# === Redis (docker-compose, bind 127.0.0.1:6380) ===
REDIS_URL=redis://localhost:6380/0

# === Шифрование секретов в БД ===
# Fernet-32 base64. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: должен оставаться неизменным между деплоями — им зашифрованы
# vision_config.x_token_encrypted и telegram_config.bot_token_encrypted.
ENCRYPTION_KEY=
# Только для ротации ключа — старый ключ, чтобы расшифровать существующие
# blob'ы и перешифровать новым. После завершения ротации убрать.
ENCRYPTION_KEY_VERIFY=

# === Telegram (singleton-config в telegram_config; здесь дефолты на bootstrap) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === API ===
# В supervisord.conf uvicorn запускается на :8000 (фикс).
# Если запускаете без supervisord (через run.sh fallback) — используется API_PORT.
API_HOST=0.0.0.0
API_PORT=8100
# Пустой → сгенерируется автоматически и допишется в .env.
API_KEY=
APP_TIMEZONE=Europe/Kaliningrad
# CORS-origin фронта в dev (Vite). В prod — публичный URL фронта.
# Пример для local-dev: FRONTEND_ORIGIN=http://localhost:5173
# Wildcard (*) запрещён — сервер упадёт при старте (CSRF-защита).
FRONTEND_ORIGIN=http://localhost:5173

# === Frontend (Vite dev-server) ===
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Telegram Mini App
MINI_PORT=5174

# === Browser Agent (Node.js gRPC) ===
GRPC_PORT=50051

# === Vision Anti-detect браузер (внешний сервис) ===
VISION_X_TOKEN=
VISION_API_URL=http://127.0.0.1:3030
VISION_PROFILE_ID=
# При true: если CDP-порт у уже открытого профиля недоступен, run.sh переоткроет
# профиль (закроет окно). false → нужно восстанавливать вручную через Vision UI.
VISION_AUTO_RESTART_ON_MISSING_CDP=true

# === Observer ===
# Интервал между scan-циклами, настраивается также через UI.
DEFAULT_OBSERVER_INTERVAL_SECONDS=90

# === Sentry (опционально) ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# === Telegram Mini App ===
TMA_SESSION_TTL_SECONDS=3600
# Публичный URL Mini App (HTTPS), прописывается в БД для inline-кнопок алертов.
# run.sh --tunnel автоматически прописывает cloudflared quick-tunnel URL.
WEB_APP_URL=

# === Daily TG Digest ===
DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_TIMEZONE=Europe/Moscow

# === AdSet.pro (внешний трекер постбэков) ===
# MCP API-ключ для исходящих запросов к AdSet.pro
ADSETPRO_MCP_KEY=
# TODO(stage-6): уточнить реальный base URL перед первым live-вызовом.
ADSETPRO_BASE_URL=https://api.adset.pro
ADSETPRO_TIMEOUT_SECONDS=15.0
# Секрет для аутентификации входящих postback'ов (header X-Postback-Secret).
# Пустой → endpoint /api/v1/postback/adsetpro возвращает 503 "not configured".
ADSETPRO_POSTBACK_SECRET=

# === Health Watchdog ===
# CSV имён воркеров, чьи worker:heartbeat:<name> мониторятся.
# Дефолт (если не задан): observer,disable,enable,telegram_poller,cleanup,reconciler,meta_api
# При несоответствии с реально запущенным набором — ложные алерты.
EXPECTED_WORKERS=
HEALTH_WATCHDOG_INTERVAL_SEC=60
HEALTH_WATCHDOG_ALERT_TTL_SEC=3600
HEALTH_WATCHDOG_OBSERVER_STALE_SEC=300

# === AI Assistant (опционально) ===
# Если ключи пусты — AI работает в no-op (не падает, просто молчит).
AI_DIAGNOSTICS_ENABLED=true
AI_CHAT_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.claudehub.fun/v1
ANTHROPIC_MODEL=claude-sonnet-4.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gateway.nekocode.app/andromeda/v1
OPENAI_MODEL=openai/gpt-5.4-mini
AI_DIAGNOSTICS_COOLDOWN_SECONDS=1800
AI_TIMEOUT_SECONDS=20
AI_MAX_LOG_LINES=200
AI_MAX_TOOL_ITERATIONS=5
AI_RATE_LIMIT_PER_HOUR=30
# Объяснения причин алертов в Telegram (приклеиваются к STOP/WARNING).
AI_EXPLAIN_ALERTS_ENABLED=true
AI_EXPLAIN_TIMEOUT_SECONDS=20.0

# === Alerts ===
ALERTS_QUEUE_ENABLED=true

# === Dev Tools ===
# Разрешает /tools/* endpoints (уникализация креативов, открытие папок, скан ФС).
# В проде оставлять false — операции с локальной ФС на сервере бессмысленны и опасны.
# Для локальной разработки: DEV_TOOLS_ENABLED=true
DEV_TOOLS_ENABLED=false
