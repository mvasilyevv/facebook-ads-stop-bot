# === База данных ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fb_stop_bot_v2
POSTGRES_USER=fb_stop_bot_v2
POSTGRES_PASSWORD=fb_stop_bot_v2

# === Redis ===
REDIS_URL=redis://localhost:6380/0

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === API ===
API_HOST=0.0.0.0
API_PORT=8100

# === Frontend ===
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5174

# === Browser Agent ===
GRPC_PORT=50051

# === Observer ===
# Интервал обновления по умолчанию (секунды), настраивается через UI
DEFAULT_OBSERVER_INTERVAL_SECONDS=90

# === Vision Anti-detect браузер ===
# X-Token из настроек Vision
VISION_X_TOKEN=
# API URL (по умолчанию localhost:3030)
VISION_API_URL=http://127.0.0.1:3030
# Profile ID из Vision (folder_id определяется автоматически)
VISION_PROFILE_ID=
# Разрешить одноразовый автоперезапуск уже открытого профиля,
# если Vision оставил его без CDP-порта. Может закрыть текущее
# окно профиля, но избавляет от ручного восстановления CDP.
VISION_AUTO_RESTART_ON_MISSING_CDP=true

# === AI-помощник (опционально) ===
# Если ключи пусты — AI работает в no-op (не падает, просто молчит).
AI_DIAGNOSTICS_ENABLED=true
AI_CHAT_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.claudehub.fun/v1
ANTHROPIC_MODEL=claude-sonnet-4.6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gateway.nekocode.app/andromeda/v1
OPENAI_MODEL=openai/gpt-5.4-mini
AI_DIAGNOSTICS_COOLDOWN_SECONDS=1800
AI_TIMEOUT_SECONDS=20
AI_MAX_LOG_LINES=200
AI_MAX_TOOL_ITERATIONS=5
AI_RATE_LIMIT_PER_HOUR=30
