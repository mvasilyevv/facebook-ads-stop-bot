# Скопируй в .env.monitoring (рядом) и заполни. Файл .env.monitoring в .gitignore.
# Переменные с именами GF_* — нативные для Grafana, читаются через env_file.
#
# Пароль admin для Grafana. Сгенерируй сильный:
#   openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=changeme

# Внешний URL Grafana (для корректных ссылок/редиректов).
# За Caddy: https://monitor.adpulse.su   Локально/туннель: http://localhost:3000
GF_SERVER_ROOT_URL=http://localhost:3000

# Ingest ports remain loopback-only by default. On an off-host monitoring node,
# bind them to a private Tailscale/WireGuard/VPC address and enforce a firewall.
MONITORING_INGEST_BIND_ADDRESS=127.0.0.1
NODE_NAME=fb-agent-monitoring-1

# Dedicated Alertmanager credential file. Provision the exact same value as
# ALERTMANAGER_WEBHOOK_SECRET on the app host. Required host mode: 0640,
# owner root, group 65534 (the pinned Alertmanager image's nobody group).
ALERTMANAGER_WEBHOOK_TOKEN_FILE=/opt/fb-agent/monitoring-secrets/alertmanager_webhook_token

# Monitoring is independently released, but it follows the same immutable
# image policy. Update these reviewed multi-architecture digests deliberately.
NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:4032c6d5bfd752342c3e631c2f1de93ba6b86c41db6b167b9a35372c139e7706
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor@sha256:3cde6faf0791ebf7b41d6f8ae7145466fed712ea6f252c935294d2608b1af388
PROMETHEUS_IMAGE=prom/prometheus@sha256:f6639335d34a77d9d9db382b92eeb7fc00934be8eae81dbc03b31cfe90411a94
LOKI_IMAGE=grafana/loki@sha256:8b5bd7748d0e4da66cd741ac276e485517514af0bea32167e27c0e1a95bcf8aa
ALLOY_IMAGE=grafana/alloy@sha256:41c41849989b7e054ccbadc17938ee1e5592fe26bfbc56ef3ffc109c0b0b2739
TEMPO_IMAGE=grafana/tempo@sha256:d7f4c72e0bad2b42b4e7263b0addaf3f5bbc105cec6b1917eba0aae3b9b70364
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:9e082985f56f4c8c9f724e18f2288c6708f472e56a5286b8863d080434ea065d
BLACKBOX_IMAGE=prom/blackbox-exporter@sha256:a50c4c0eda297baa1678cd4dc4712a67fdea713b832d43ce7fcc5f9bea05094d
GRAFANA_IMAGE=grafana/grafana@sha256:408afb9726de5122b00a2576763a8a57a3c86d5b0eff5305bc994ceb3eb96c3f
