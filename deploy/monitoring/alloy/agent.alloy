logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host                = "unix:///var/run/docker.sock"
  port                = 9464
  match_first_network = true
}

discovery.relabel "metrics" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_fb_agent_metrics"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = [
      "__meta_docker_network_ip",
      "__meta_docker_container_label_com_fb_agent_metrics_port",
    ]
    separator    = ":"
    regex        = "(.+):([0-9]+)"
    replacement  = "$1:$2"
    target_label = "__address__"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_fb_agent_release"]
    target_label  = "release"
  }

  rule {
    replacement  = "fb-agent-runtime"
    target_label = "job"
  }
}

prometheus.scrape "fb_agent" {
  targets         = discovery.relabel.metrics.output
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

// browser-agent shares Vision's network namespace. Docker reports no network
// IP on that container, so it cannot produce a Docker-discovery target.
prometheus.scrape "browser_agent" {
  targets = [{
    "__address__"      = "vision-webtop:9464",
    "job"              = "fb-agent-runtime",
    "node"             = sys.env("NODE_NAME"),
    "service"          = "browser-agent",
  }]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

// The central exporters describe the monitoring node. These two exporters run
// on every application host so CPU, disk and container saturation cannot be
// mistaken for monitoring-host health.
prometheus.scrape "application_host" {
  targets = [
    {
      "__address__" = "node-exporter:9100",
      "job"         = "node",
      "node"        = sys.env("NODE_NAME"),
      "role"        = "application",
    },
    {
      "__address__" = "cadvisor:8080",
      "job"         = "cadvisor",
      "node"        = sys.env("NODE_NAME"),
      "role"        = "application",
    },
  ]
  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = {platform = "docker", node = sys.env("NODE_NAME")}
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
  }
}

// Applications send OTLP only across the private Docker network. The agent
// batches spans and owns the authenticated off-host HTTPS hop to Tempo.
otelcol.receiver.otlp "applications" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval = "1s"
  limit          = "256MiB"

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 1024

  output {
    traces = [otelcol.exporter.otlphttp.central_tempo.input]
  }
}

otelcol.exporter.otlphttp "central_tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_HTTP_URL")
  }
}
