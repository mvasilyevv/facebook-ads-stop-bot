[Unit]
Description=FB Agent pgBackRest daily differential backup
Requires=docker.service
After=docker.service
OnFailure=fb-agent-host-operation-failed@pgbackrest_diff.service

[Service]
Type=oneshot
Environment=FB_AGENT_ROOT=/opt/fb-agent
ExecStart=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/pgbackrest-admin.sh -- --backup-env /opt/fb-agent/shared/pgbackrest.env --config-file /opt/fb-agent/shared/pgbackrest.conf diff
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
