[Unit]
Description=FB Agent application-host Alloy telemetry agent
Requires=docker.service
After=docker.service network-online.target fb-agent.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=FB_AGENT_ROOT=/opt/fb-agent
ExecStart=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-alloy-agent.sh -- up
ExecReload=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-alloy-agent.sh -- restart
ExecStop=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-alloy-agent.sh -- stop
TimeoutStartSec=3min
TimeoutStopSec=1min

[Install]
WantedBy=multi-user.target
