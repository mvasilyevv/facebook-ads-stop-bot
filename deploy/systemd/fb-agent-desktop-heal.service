[Unit]
Description=FB Agent desktop-aware browser/CDP recovery
Requires=docker.service
After=docker.service fb-agent.service fb-agent-desktop-agent.service network-online.target
Wants=network-online.target
OnFailure=fb-agent-host-operation-failed@desktop_healer.service

[Service]
Type=oneshot
Environment=FB_AGENT_ROOT=/opt/fb-agent
ExecStart=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state desktop --entrypoint scripts/platform-desktop-heal.sh --
TimeoutStartSec=15min
