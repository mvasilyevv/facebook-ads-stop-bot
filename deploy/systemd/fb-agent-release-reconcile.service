[Unit]
Description=Reconcile FB Agent atomic release state before public traffic
Requires=docker.service
After=local-fs.target docker.service network-online.target
Before=caddy.service fb-agent.service
Wants=network-online.target
OnFailure=fb-agent-host-operation-failed@release_boot_reconcile.service
[Service]
Type=oneshot
RemainAfterExit=yes
Environment=FB_AGENT_ROOT=/opt/fb-agent
EnvironmentFile=-/etc/fb-agent/release-reconciler.env
ExecStart=/usr/local/libexec/fb-agent-release-reconciler/current/reconcile-platform-release.sh --boot --deadline-seconds 180
TimeoutStartSec=185

[Install]
WantedBy=multi-user.target
