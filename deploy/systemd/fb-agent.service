[Unit]
Description=FB Agent production stack
Requires=docker.service fb-agent-release-reconcile.service
After=docker.service network-online.target fb-agent-release-reconcile.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=FB_AGENT_ROOT=/opt/fb-agent
ExecStart=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-compose.sh -- up
ExecReload=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-compose.sh -- restart
ExecStop=/usr/local/libexec/fb-agent-release-verifier/current/verified-release-exec.py --state app --entrypoint scripts/platform-compose.sh -- stop
TimeoutStartSec=15min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
