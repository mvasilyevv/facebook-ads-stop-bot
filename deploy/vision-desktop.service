[Unit]
Description=Полный рабочий стол XFCE на Xvfb :99 (для RustDesk + окно Vision)
After=xvfb.service
Requires=xvfb.service
Before=vision.service

[Service]
User=mark
Group=mark
Environment=DISPLAY=:99
Environment=HOME=/home/mark
# dbus-run-session — XFCE требует session bus; startxfce4 поднимает xfwm4 + panel + desktop
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/startxfce4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
