# chmod 600. The S3-compatible bucket must be off-host, versioned, encrypted,
# and protected by Object Lock/immutability where the provider supports it.
PGBACKREST_REPO1_S3_BUCKET=fb-agent-production-backups
PGBACKREST_REPO1_S3_ENDPOINT=s3.example.internal
PGBACKREST_REPO1_S3_REGION=eu-central-1
PGBACKREST_REPO1_S3_KEY=replace-me
PGBACKREST_REPO1_S3_KEY_SECRET=replace-me
PGBACKREST_REPO1_S3_URI_STYLE=host
PGBACKREST_REPO1_CIPHER_PASS=replace-with-64-random-characters
