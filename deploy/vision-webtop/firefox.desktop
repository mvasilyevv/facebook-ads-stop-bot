[Desktop Entry]
Type=Application
Name=Firefox
Name[en]=Firefox
Comment=Обычный браузер для облачных панелей. Кабинеты Facebook открывать только через профиль Vision.
Comment[en]=Plain browser for cloud panels. Open Facebook accounts only through a Vision profile.
Exec=/opt/firefox/firefox %u
Icon=/opt/firefox/browser/chrome/icons/default/default128.png
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
