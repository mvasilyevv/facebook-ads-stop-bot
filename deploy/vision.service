[Unit]
Description=Vision anti-detect браузер (FB Stop Bot) на Xvfb :99
After=xvfb.service network-online.target
Requires=xvfb.service
Wants=network-online.target

[Service]
User=mark
Group=mark
Environment=DISPLAY=:99
Environment=HOME=/home/mark
# dbus-run-session — GUI Vision требует session bus (xdg-desktop-portal и пр.)
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/Vision
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
