[Unit]
Description=panel-auth — login-gate для app.adpulse.su (forward_auth :8090)
After=network.target
Before=caddy.service

[Service]
Type=simple
EnvironmentFile=/opt/panel-auth/.env
ExecStart=/opt/panel-auth/venv/bin/python /opt/panel-auth/app.py
Restart=always
RestartSec=2
User=root
# Гейт панели — лёгкий stdlib-сервис; авто-рестарт при падении.
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
