[Unit]
Description=Оконный менеджер xfwm4 на Xvfb :99 (рамки окон Vision)
After=xvfb.service
Requires=xvfb.service
Before=vision.service

[Service]
User=mark
Group=mark
Environment=DISPLAY=:99
Environment=HOME=/home/mark
ExecStart=/usr/bin/xfwm4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
