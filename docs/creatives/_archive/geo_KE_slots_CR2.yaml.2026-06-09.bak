# Слот CR2 (Chicken Road 2) в гео KE. Наследует geo_hooks из ../geo.yaml.
# code креатива == sub3 в трекере (джойн-ключ). См. docs/creatives/_schema.md

code: CR2
geo: KE
offer_code: KE_CR2          # связь с offers в БД
name: Chicken Road 2
mechanic: "crash-game (курица перебегает дорогу, растущий множитель, кэшаут до краха)"

# ---------------- Идеи / углы под слот ----------------
ideas:
  - id: cr2_proof_post
    desc: "Нативный отзыв от 1-го лица + крупный пруф зачисления M-Pesa (формула чемпиона)"
    type: social_proof
    hooks: [vis_native_fb_post, vis_mpesa_green_proof, vis_skepticism_overcome, vis_live_comments, ke_mpesa_payout]

  - id: cr2_withdrawal_focus
    desc: "Акцент на ВЫВОД (не депозит) — самый сильный trust-триггер на KE"
    type: payment_trust
    hooks: [vis_native_fb_post, vis_mpesa_green_proof, ke_mpesa_payout]

  - id: cr2_chat_format
    desc: "Формат переписки: входящее M-Pesa SMS + чат с другом + мини-скрин геймплея"
    type: format
    hooks: [vis_mpesa_green_proof, ke_swahili_touch]

  - id: cr2_speed_cashout
    desc: "Скорость вывода: M-Pesa за 2 минуты, таймер 00:02"
    type: speed
    hooks: [ke_instant_cashout, vis_mpesa_green_proof]

  - id: cr2_first_win
    desc: "Первый успех новичка при низком пороге входа"
    type: social_proof
    hooks: [ke_low_entry_153, vis_native_fb_post, ke_mpesa_payout]

  - id: cr2_anti_objection
    desc: "Снятие возражения «нужно много денег» — но живым постом, не баннером"
    type: objection_kill
    hooks: [ke_low_entry_153, vis_native_fb_post]

# ---------------- Референсы (свои + конкуренты из Ad Library) ----------------
references:
  - id: ref_cr005
    source: own
    format: static
    file: "~/Documents/FB_Agent_Creo/KE_CR2_2026-05-21_16-41-42_3creo_3copies/1/KE_CR2_CR005_1.jpeg"
    why: "Наш чемпион — главный визуальный референс для всех Proof-Posts."

  - id: ref_arcade_chicken
    source: ad_library
    advertiser: "Arcade Chicken World"
    format: static
    long_active_days: 2
    why: "Весь текст на «real M-PESA cash» + локальность (matatus, after work) + urgency «promo ends». Независимое подтверждение M-Pesa-инсайта."

  - id: ref_minigamecorner
    source: ad_library
    advertiser: "Mini Game Corner"
    format: ugc_text
    long_active_days: 1
    why: "UGC-сторителлинг от 1-го лица «money landed on my phone 💸 Kenyan players eating on this 🇰🇪» — ровно наша CR005-формула."

  - id: ref_1xbet
    source: ad_library
    advertiser: "1XBET Kenya"
    format: video
    long_active_days: 3
    why: "Видео 0:10 «legendary CR2 officially here», real withdrawals. Закрывает пробел видео-формата на KE."

  - id: ref_moyo
    source: ad_library
    advertiser: "Moyo Bet"
    format: static
    long_active_days: 18
    why: "Долгожитель. Официальность «1M players» + суахили («Cheza sasa»). Маскировка названия (Chicken Cross/Farm Road) — у нас не нужна (whitelist)."

  - id: ref_chickendash
    source: ad_library
    advertiser: "Chicken Dash World"
    format: static
    long_active_days: 1
    why: "Adrenaline/FOMO «before the game goes crazy — fast rounds, risky jumps. Kenya's Fastest Growing ⭐4.9»."

  - id: ref_plinko
    source: ad_library
    advertiser: "Plinko 2"
    format: static
    long_active_days: 20
    why: "Соседний жанр (Plinko), максимальный скейл (×7 дублей) — бенчмарк живучести."

