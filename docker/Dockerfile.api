# FastAPI сервер FB Stop Bot
ARG BASE_IMAGE=fb-stop-bot/python-base:latest
FROM ${BASE_IMAGE} AS runtime

EXPOSE 8100

# Healthcheck через /healthz (k8s liveness; /health не существует — был баг)
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8100/healthz || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8100", "--no-access-log"]
