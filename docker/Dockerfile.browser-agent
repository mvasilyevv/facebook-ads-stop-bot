# Browser-agent: Node.js + gRPC-сервер для управления Vision-профилями
# Vision браузер работает на хосте — этот образ только gRPC-клиент + сервер
FROM node:20-slim AS builder

WORKDIR /app

# Копируем файлы зависимостей
COPY services/browser-agent/package.json services/browser-agent/package-lock.json ./

# Устанавливаем только production зависимости для финального образа
RUN npm ci

# Копируем исходный код и конфиги
COPY services/browser-agent/src ./src
COPY services/browser-agent/tsconfig.json ./

# Собираем TypeScript → JavaScript
RUN npm run build

# Финальный образ
FROM node:20-slim AS runtime

WORKDIR /app

# Копируем собранный dist и production node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY services/browser-agent/package.json ./
# dist/index.js резолвит ../../../proto/v1 относительно /app/dist → /proto/v1.
# Эти runtime-схемы нужны proto-loader при старте gRPC-сервера.
COPY proto/v1 /proto/v1

EXPOSE 50051

CMD ["node", "dist/index.js"]
