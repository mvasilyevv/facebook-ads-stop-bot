ARG POSTGRES_BASE_IMAGE=postgres:16-bookworm@sha256:92620daddcd947f8d5ab5ba66e848702fe443d87fed30c4cea8e389fd78dfc55
FROM ${POSTGRES_BASE_IMAGE}

# The safety-first infra project archives WAL with pgBackRest.  This image is
# built in CI and consumed by digest; production never installs packages at
# container startup.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates pgbackrest \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o postgres -g postgres -m 0750 \
        /var/log/pgbackrest /var/spool/pgbackrest
