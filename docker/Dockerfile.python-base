# Многоступенчатая сборка Python-образа для FB Stop Bot
# Стадия сборки: устанавливаем зависимости через uv
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

# Системные зависимости для сборки
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем uv
COPY --from=ghcr.io/astral-sh/uv:0.9.18@sha256:5713fa8217f92b80223bc83aac7db36ec80a84437dbc0d04bbc659cae030d8c9 /uv /usr/local/bin/uv

WORKDIR /app

# Копируем файлы зависимостей для кэширования слоёв
COPY pyproject.toml uv.lock ./

# Устанавливаем зависимости в /opt/venv
RUN uv sync --frozen --no-dev --no-install-project \
    --python python3.12

# Финальный образ: только runtime
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime

# Runtime-зависимости: libpq + ffmpeg/ffprobe (уникализация видео-креативов в
# campaign_creator — core/creatives/video_uniquifier требует ffprobe в PATH).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем виртуальное окружение из builder
COPY --from=builder /app/.venv /app/.venv

# Добавляем venv в PATH
# PYTHONPATH=/app — чтобы скрипты из подпапок (scripts/apply_schema.py) видели
# пакет core; иначе sys.path[0]=каталог скрипта, не корень → ModuleNotFoundError.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Копируем весь исходный код
COPY . .
