# Многоступенчатая сборка Python-образа для FB Agent
# Стадия сборки: устанавливаем зависимости через uv
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

# Системные зависимости для сборки
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем uv
COPY --from=ghcr.io/astral-sh/uv:0.9.18@sha256:5713fa8217f92b80223bc83aac7db36ec80a84437dbc0d04bbc659cae030d8c9 /uv /usr/local/bin/uv

WORKDIR /app

# Копируем файлы зависимостей для кэширования слоёв
COPY pyproject.toml uv.lock ./

# Creative registry is runtime data, but reports and source media under the
# same tree are not. Filter in the disposable builder so those assets never
# become layers of the production image.
COPY docs/creatives /tmp/runtime-creatives
RUN find /tmp/runtime-creatives -type f ! -name '*.yaml' -delete

# Устанавливаем зависимости в /opt/venv
RUN uv sync --frozen --no-dev --no-install-project \
    --python python3.12

# Финальный образ: только runtime
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime

# Runtime-зависимости: libpq + ffmpeg/ffprobe (уникализация видео-креативов в
# campaign_creator — core/creatives/video_uniquifier требует ffprobe в PATH).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем виртуальное окружение из builder
COPY --from=builder /app/.venv /app/.venv

# Добавляем venv в PATH
# PYTHONPATH=/app — чтобы скрипты из подпапок (scripts/apply_schema.py) видели
# пакет core; иначе sys.path[0]=каталог скрипта, не корень → ModuleNotFoundError.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy only application runtime inputs. Deployment automation, CI, docs,
# tests, local caches and repository metadata must not affect this image.
COPY apps ./apps
COPY clients ./clients
COPY core ./core
COPY migrations ./migrations
COPY proto ./proto
COPY alembic.ini sitecustomize.py ./
COPY run_*.py ./
COPY scripts/run-migrations-locked.py \
     scripts/adopt-first-release.py \
     scripts/adoption-receipt-status.py \
     scripts/bootstrap-runtime-config.py \
     scripts/bootstrap-vision-config.py \
     scripts/check-database-contract.py \
     scripts/configure-telegram-webhook.py \
     ./scripts/
COPY --from=builder /tmp/runtime-creatives ./docs/creatives
