# Универсальный образ для всех Python-воркеров
# Воркер выбирается через переменную окружения WORKER_TYPE
ARG BASE_IMAGE=fb-stop-bot/python-base:latest
FROM ${BASE_IMAGE} AS runtime

# Копируем entrypoint-скрипт
COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh

# WORKER_TYPE должен быть переопределён при запуске контейнера (см. worker-entrypoint.sh).
# Допустимые значения: observer, telegram_poller, cleanup, reconciler, meta_api,
# health_watchdog, enable_recommendation, digest_scheduler, cabinet_scheduler,
# tracker_aggregator, creator_worker, creator_recorder, migrate.
ENV WORKER_TYPE=observer

ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
