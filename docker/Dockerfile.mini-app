# Telegram Mini App: сборка и упаковка в nginx (base path /tma/)
FROM node:20 AS builder

# VITE_API_BASE передаётся при сборке образа
ARG VITE_API_BASE=/api

WORKDIR /app

COPY frontend-mini/package.json frontend-mini/package-lock.json ./
RUN npm ci

# Копируем mini-app и общие утилиты (используются через алиас @shared)
COPY frontend-mini/ ./
COPY frontend/src/shared ../frontend/src/shared

RUN VITE_API_BASE=${VITE_API_BASE} npm run build

# Финальный образ: nginx со статикой
FROM nginx:alpine AS runtime

# Конфигурация для пути /tma/
COPY docker/nginx-tma.conf /etc/nginx/conf.d/default.conf

# Копируем собранную статику
COPY --from=builder /app/dist /usr/share/nginx/html/tma

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
