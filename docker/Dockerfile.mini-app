# Telegram Mini App: сборка в pnpm workspace монорепо и упаковка в nginx (base path /tma/)
# node:22 — pnpm 11.6 (packageManager) несовместим с node:20 (ERR_UNKNOWN_BUILTIN_MODULE).
FROM node:22-slim AS builder

# VITE_API_BASE передаётся при сборке образа
ARG VITE_API_BASE=/api
ARG VITE_REMOTE_DESKTOP_URL=

# Установка pnpm через corepack — pin на 11.6.0 (как в packageManager).
# pnpm@latest (11.8) НЕ читает onlyBuiltDependencies из pnpm-workspace.yaml →
# ERR_PNPM_IGNORED_BUILDS на esbuild валит сборку; 11.6.0 читает корректно.
RUN corepack enable && corepack prepare pnpm@11.6.0 --activate

WORKDIR /app

# --- Слой кэша зависимостей ---
# Копируем только манифесты и lockfile монорепо, чтобы docker кэшировал
# слой node_modules отдельно от исходников.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
# tsconfig.base.json — frontend-mini/tsconfig.json extends ../tsconfig.base.json
# (target ES2022 + skipLibCheck). Без него tsc -b берёт дефолты → TS18028 на vitest .d.ts.
COPY tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/package.json
COPY frontend-mini/package.json ./frontend-mini/package.json

# Устанавливаем зависимости всего workspace (нужен shared для резолва @fb/shared).
# dangerouslyAllowAllBuilds: pnpm в чистом Docker-store блокирует build-скрипты
# (esbuild/@tailwindcss/oxide) даже при onlyBuiltDependencies → флаг разрешает их явно.
RUN pnpm install --frozen-lockfile --config.dangerouslyAllowAllBuilds=true

# --- Слой исходников ---
COPY packages/shared/ ./packages/shared/
COPY frontend-mini/ ./frontend-mini/

# Сборка только пакета fb-agent-mini (shared резолвится из workspace напрямую через src)
RUN VITE_API_BASE=${VITE_API_BASE} \
    VITE_REMOTE_DESKTOP_URL=${VITE_REMOTE_DESKTOP_URL} \
    pnpm --filter fb-agent-mini build

# Финальный образ: nginx со статикой
FROM nginx:alpine AS runtime

# Конфигурация для пути /tma/
COPY docker/nginx-tma.conf /etc/nginx/conf.d/default.conf

# Копируем собранную статику
COPY --from=builder /app/frontend-mini/dist /usr/share/nginx/html/tma

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
