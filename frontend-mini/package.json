{
  "name": "fb-agent-mini",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../packages/shared/scripts/check-frontend-budget.mjs --dist ./dist --feature OperatorMiniDashboard.tsx --js-budget 160000 --font-budget 100000",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fb/features": "workspace:*",
    "@fb/operator-api": "workspace:*",
    "@fb/operator-ui": "workspace:*",
    "@fb/shared": "workspace:*",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.6",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.95.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.95.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^15.14.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
