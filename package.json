{
  "name": "fb-stop-bot-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:web": "pnpm --filter fb-stop-bot-frontend dev",
    "dev:mini": "pnpm --filter fb-agent-mini dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:openapi": "pnpm --dir frontend exec prettier --write --config .prettierrc.json openapi.json",
    "format:api": "pnpm --dir frontend exec prettier --write --config .prettierrc.json ../packages/shared/src/api/generated.ts",
    "export:openapi": "${PYTHON:-python3} -B scripts/export_openapi.py && pnpm run format:openapi",
    "gen:api": "openapi-typescript ./frontend/openapi.json -o ./packages/shared/src/api/generated.ts && pnpm run format:api",
    "sync:api": "pnpm run export:openapi && pnpm run gen:api"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.6.0"
}
