{
  "name": "fb-stop-bot-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:web": "pnpm --filter fb-stop-bot-frontend dev",
    "dev:mini": "pnpm --filter fb-agent-mini dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "gen:api": "openapi-typescript ./frontend/openapi.json -o ./packages/shared/src/api/generated.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.6.0"
}
