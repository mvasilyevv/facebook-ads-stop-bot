{
  "name": "@fb-agent/browser-agent",
  "version": "0.1.0",
  "private": true,
  "description": "gRPC browser automation service for FB Ads Manager monitoring",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.13",
    "playwright": "^1.52.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
